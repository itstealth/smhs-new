<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Group Admissions API" stopProcessing="true">
          <match url="^api/admission-payment$" />
          <action type="Rewrite" url="http://localhost:3003/api/admissions" />
        </rule>
        <rule name="Group App Assets" stopProcessing="true">
          <match url="^_grp/(.*)" />
          <action type="Rewrite" url="http://localhost:3003/_grp/{R:1}" />
        </rule>
        <rule name="Central Admissions Pages" stopProcessing="true">
          <match url="^admissions/(receipt|thank-you|failed)(/.*)?$" />
          <action type="Rewrite" url="http://localhost:3003/admissions/{R:1}{R:2}" appendQueryString="true" />
        </rule>
        <!-- Static root files - serve directly -->
        <rule name="Static Root Files" stopProcessing="true">
          <match url="^(robots\.txt|llms\.txt)$" />
          <action type="None" />
        </rule>
        <!-- WordPress admin - pass through to PHP -->
        <rule name="WP Admin" stopProcessing="true">
          <match url="^blog/wp-admin(/.*)?$" />
          <action type="None" />
        </rule>
        <!-- WordPress login - pass through to PHP -->
        <rule name="WP Login" stopProcessing="true">
          <match url="^blog/wp-login\.php$" />
          <action type="None" />
        </rule>
        <!-- WordPress cron - pass through to PHP -->
        <rule name="WP Cron" stopProcessing="true">
          <match url="^blog/wp-cron\.php$" />
          <action type="None" />
        </rule>
        <!-- WordPress REST API - rewrite to blog index.php -->
        <rule name="WP REST API" stopProcessing="true">
          <match url="^blog/wp-json(/.*)?$" />
          <action type="Rewrite" url="blog/index.php" />
        </rule>
        <!-- WordPress static assets (wp-content, wp-includes) - pass through -->
        <rule name="WP Static" stopProcessing="true">
          <match url="^blog/(wp-content|wp-includes)(/.*)?$" />
          <action type="None" />
        </rule>
        <!-- All other requests go to Next.js -->
        <rule name="NextJS" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3001/{R:1}" />
        </rule>
      </rules>

    </rewrite>
    <httpProtocol>
      <customHeaders>
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-XSS-Protection" value="1; mode=block" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>