# Base URL of the CMS instance that serves this site's content
# (app/api/public/v1/[collection] in the cms repo).
CMS_URL=http://localhost:3002

# Read-only bearer token scoped to this institution (SMHS), minted via
# lib/content/api-tokens.ts createApiToken() in the cms repo. Grants read
# access to this institution's published content only -- see lib/cms.ts.
CMS_TOKEN=cms_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
