# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large unused image folders
/public/smhs_images/events/
/public/smhs_images/seedling_images/img[0-9]*.jpg
/public/smhs_images/seedling_images/IMG*.jpg

# Large binary assets - served from server directly
/public/*.mp4
/public/*.webm
/public/*.pdf
/public/alumni/
/public/assets/
/public/smhs_images/
/public/events/
